; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Storm Island"
config/description="Third-person battle royale prototype for PC and Android."
run/main_scene="res://scenes/Main.tscn"
boot_splash/image="res://assets/ui/splash.png"
boot_splash/bg_color=Color( 0.02, 0.03, 0.08, 1 )
config/icon="res://icon.png"

[audio]

enable_audio_input=true

[autoload]

Settings="*res://scripts/Settings.gd"
Accounts="*res://scripts/Accounts.gd"
Net="*res://scripts/Net.gd"
Audio="*res://scripts/Audio.gd"
Controls="*res://scripts/Controls.gd"
Voice="*res://scripts/Voice.gd"

[display]

window/size/width=1280
window/size/height=720
window/handheld/orientation="sensor_landscape"
window/stretch/mode="2d"
window/stretch/aspect="expand"

[rendering]

quality/driver/fallback_to_gles2=true
vram_compression/import_etc=true
